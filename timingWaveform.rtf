/*\
sanity check of different type of fits (peak vs leading edge)\
\
1. per event, per channel, plot peakTime-frontTime vs peak charge\
\
\
*/\
const int NCHAN = 30;\
const float TRIGTIME = 700.;\
const float BADTIME = 10000.;\
const float POVERLAPT = 32;\
\
Double_t getSPEval(int chan, TTree * tt, bool verbose = false)\{\
  // TCanvas * c = new TCanvas();\
  // TH1F * histQ = new TH1F("histQ", "histQ", 200, 0, 300000/2000);\
  // tt->Draw("ch27.pulse.charge/2400 >> histQ", "ch27.pulse.charge > 100", "hist");\
  // c->Update();\
  TH1F * histQ = new TH1F("histQ", "histQ", 120, 0, 10000);\
  tt->Draw(("ch" + to_string(chan) + ".pulse.charge >> histQ").c_str(), ("ch" + to_string(chan) + ".pulse.charge > 100").c_str(), "goff");\
  float gausWidth = 600.;\
  TSpectrum * s = new TSpectrum(10);\
  s->Search(histQ, 2., "goff", 0.05);\
  Double_t * xPeaks = s->GetPositionX();\
  TF1 * fgaus = new TF1("fgaus", "gaus", xPeaks[0] - gausWidth, xPeaks[0] + gausWidth);\
  fgaus->SetParameters(histQ->GetMaximum(), xPeaks[0], gausWidth/4);\
  histQ->Fit("fgaus", "QRN0");\
  Double_t q1PE = fgaus->GetParameter(1);\
  \
  TF1 * fgaus2 = new TF1("fgaus2", "gaus", xPeaks[1] - gausWidth, xPeaks[1] + gausWidth);\
  fgaus2->SetParameters(histQ->GetMaximum(), xPeaks[1]*0.9, gausWidth/4);\
  histQ->Fit("fgaus2", "QRN0");\
  Double_t q2PE = fgaus2->GetParameter(1);\
  Double_t spe = q2PE - q1PE;\
  Double_t fullSig = TMath::Sqrt(fgaus->GetParameter(2)*fgaus->GetParameter(2) + fgaus2->GetParameter(2)*fgaus2->GetParameter(2));\
\
  printf("ch = %i  chi2 = %0.1f %0.1f   QSPE = %0.2f    res = %0.2f\\n", chan, fgaus->GetChisquare()/fgaus->GetNDF(), fgaus2->GetChisquare()/fgaus2->GetNDF(), spe, spe/fullSig);\
  if(verbose == true)\{\
    gStyle->SetOptFit(1);\
    histQ->Draw("hist");\
    fgaus->Draw("same");\
    fgaus2->Draw("same");\
  \} else \{\
    delete fgaus;\
    delete histQ;\
  \}\
  return spe;\
\}\
\
std::pair<float, int> getFirstPhoton(std::vector<std::vector<float>> * times, float trigTime)\{\
  vector<float> firstPhotons = \{\};\
  vector<int> firstPhotonsch = \{\};\
  for(int ich = 0; ich < NCHAN; ich++)\{ //channel loop\
    if(times->at(ich).size() == 0) continue; //skip empty channels\
    float cht0 = times->at(ich).at(0); //first photon\
    if(cht0 > trigTime)\{\
      firstPhotons.push_back(cht0); // physics trigger cut (no pre-pulses)\
      firstPhotonsch.push_back(ich);\
    \}\
  \}//end channel loop\
  if(firstPhotons.size() < 1)\{ //faulty event\
    return pair<float, int> (BADTIME, -1);\
  \}\
  float t0 = *min_element(firstPhotons.begin(), firstPhotons.end());\
  int ch0 = firstPhotonsch[min_element(firstPhotons.begin(), firstPhotons.end()) - firstPhotons.begin()];\
  return pair<float, int> (t0, ch0);\
\}\
